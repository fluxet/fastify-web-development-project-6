<!doctype html>
<html lang="en">
  <head>
    <title>Hexlet Fastify Boilerplate</title>
    <script src="<%= it.assetPath('main.js') %>"></script>
    <link href="<%= it.assetPath('main.css') %>" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900">
    <nav class="mb-6 border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <a class="text-lg font-semibold text-slate-900" href="<%= it.route('root') %>"><%= it.t('appName') %></a>
          <a class="text-sm font-medium text-slate-600 hover:text-slate-950" href="<%= it.route('users') %>"><%= it.t('layouts.application.users') %></a>
        </div>
        <div class="flex items-center gap-4">
          <% if (it.isAuthenticated()) { %>
            <%~ include("../mixins/buttonTo", {
              action: it.route('session'),
              method: 'delete',
              class: 'text-sm font-medium text-slate-600 hover:text-slate-950',
              value: it.t('layouts.application.signOut'),
            }) %>
          <% } else { %>
          <a class="text-sm font-medium text-slate-600 hover:text-slate-950" href="<%= it.route('newSession') %>"><%= it.t('layouts.application.signIn') %></a>
          <a class="text-sm font-medium text-slate-600 hover:text-slate-950" href="<%= it.route('newUser') %>"><%= it.t('layouts.application.signUp') %></a>
          <% } %>
        </div>
      </div>
    </nav>
    <main class="mx-auto w-full max-w-6xl flex-1 px-4 sm:px-6 lg:px-8">
      <% Object.entries(it.reply.flash() || {}).forEach(([type, messages]) => { %>
        <% messages.forEach((message) => { %>
        <div class="mb-4 rounded-md border px-4 py-3 text-sm <%= it.getAlertClass(type) %>" role="alert"><%= message %></div>
        <% }) %>
      <% }) %>

      <h1 class="mb-6 text-3xl font-semibold tracking-normal text-slate-950"><%= it.header ?? '' %></h1>
      <%~ it.body %>
    </main>

    <footer>
      <div class="mx-auto my-10 w-full max-w-6xl border-t border-slate-200 px-4 pt-6 sm:px-6 lg:px-8">
        <a class="text-sm font-medium text-blue-600 hover:text-blue-800" target="_blank" href="https://ru.hexlet.io">Hexlet</a>
      </div>
    </footer>
  </body>
</html>
