<% layout("../layouts/application") %>
<div class="rounded-md border border-slate-200 bg-white">
  <div class="p-8 sm:p-12">
    <div class="text-4xl font-semibold tracking-normal text-slate-950 sm:text-5xl"><%= it.t('views.welcome.index.hello') %></div>
    <p class="mt-3 text-lg text-slate-600"><%= it.t('views.welcome.index.description') %></p>
    <hr class="my-6 border-slate-200">
    <a class="inline-flex items-center rounded-md bg-blue-600 px-5 py-3 text-base font-medium text-white hover:bg-blue-700" href="https://hexlet.io"><%= it.t('views.welcome.index.more') %></a>
  </div>
</div>
